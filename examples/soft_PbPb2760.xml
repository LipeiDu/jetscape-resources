<?xml version='1.0' encoding='utf-8'?>
<jetscape>
  <nEvents>1</nEvents>
  <setReuseHydro>false</setReuseHydro>
  <nReuseHydro>1</nReuseHydro>
  <Random>
    <seed>261023101</seed>
  </Random>
  <outputFilename>event</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ>
  <write_centrality> 1 </write_centrality>
  <write_pthat> 1 </write_pthat>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 1 </nEvents_printout>
  <IS>
    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 0 </grid_max_z>
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>
    <Trento>
      <PhysicsInputs projectile="Pb" target="Pb" sqrts="2760" cross-section="6.4" normalization="14.2">
          </PhysicsInputs>
      <CutInputs centrality-low="30" centrality-high="40">
          </CutInputs>
      <TransInputs reduced-thickness="0.063" fluctuation="0.9070294784580498" nucleon-width="1.12" nucleon-min-dist="1.437425957118835">
          </TransInputs>
      <LongiInputs mean-coeff="1.0" std-coeff="3.0" skew-coeff="0.0" skew-type="1" jacobian="0.8">
          </LongiInputs>
    </Trento>
  </IS>
  <Preequilibrium>
    <tau0>0.0</tau0>
    <tauj>0.1</tauj>
    <taus>1.46</taus>
    <evolutionInMemory>1</evolutionInMemory>
    <FreestreamMilne>
      <name>FreestreamMilne</name>
      <freestream_input_file>freestream_input</freestream_input_file>
      <ntau>50</ntau>
      <E_DEP_FS>1</E_DEP_FS>
      <E_R>4.0</E_R>
      <TAU_R>1.46</TAU_R>
      <ALPHA>0.031</ALPHA>
    </FreestreamMilne>
  </Preequilibrium>
  <Hydro>
    <MUSIC>
      <beastMode>0</beastMode>
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <surface_in_memory>1</surface_in_memory>
      <Initial_time_tau_0>1.46</Initial_time_tau_0>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <eta_over_s_T_kink_in_GeV>0.223</eta_over_s_T_kink_in_GeV>
      <eta_over_s_low_T_slope_in_GeV>-0.776</eta_over_s_low_T_slope_in_GeV>
      <eta_over_s_high_T_slope_in_GeV>0.37</eta_over_s_high_T_slope_in_GeV>
      <eta_over_s_at_kink>0.096</eta_over_s_at_kink>
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      <zeta_over_s_max>0.133</zeta_over_s_max>
      <zeta_over_s_T_peak_in_GeV>0.12</zeta_over_s_T_peak_in_GeV>
      <zeta_over_s_width_in_GeV>0.072</zeta_over_s_width_in_GeV>
      <zeta_over_s_lambda_asymm>-0.122</zeta_over_s_lambda_asymm>
      <freezeout_temperature>0.136</freezeout_temperature>
      <MUSIC_input_file>music_input</MUSIC_input_file>
      <Include_second_order_terms>1</Include_second_order_terms>
    </MUSIC>
  </Hydro>
  <SoftParticlization>
    <iSS>
      <iSS_input_file>iSS_parameters.dat</iSS_input_file>
      <iSS_table_path>iSS_tables</iSS_table_path>
      <iSS_particle_table_path>iSS_tables</iSS_particle_table_path>
      <afterburner_type>2</afterburner_type>
      <number_of_repeated_sampling>3</number_of_repeated_sampling>
      <Perform_resonance_decays>0</Perform_resonance_decays>
      <hydro_mode>1</hydro_mode>
      <include_deltaf_shear>1</include_deltaf_shear>
      <include_deltaf_bulk>1</include_deltaf_bulk>
      <deltaf_type>20</deltaf_type>
    </iSS>
  </SoftParticlization>
  <Afterburner>
    <SMASH>
      <name>SMASH</name>
      <SMASH_config_file>smash_config.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>
      <end_time>1000.0</end_time>
      <only_decays>0</only_decays>
    </SMASH>
  </Afterburner>
  <Writer>
    <FinalStateHadrons>
      <headerVersion>2</headerVersion>
      <statusToSkip>-9999</statusToSkip>
    </FinalStateHadrons>
    <JetscapeWriterFinalStateBinaryOutput>0</JetscapeWriterFinalStateBinaryOutput>
  </Writer>
  <enableAutomaticTaskListDetermination>true</enableAutomaticTaskListDetermination>
</jetscape>